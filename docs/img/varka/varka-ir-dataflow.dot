digraph VarkaIRDataFlow {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, labelloc=t, pad=0.4, nodesep=0.18, ranksep=1.1, concentrate=true, newrank=true, bgcolor="white",
    label=<<b>Varka IR: data flow between nodes</b><br/><font point-size="9">Left: where a value can come from. Middle: every operator with one port per input component. Right: what each operator produces, and where it can go next - a produced value feeds the matching source on the left (dotted), so any date-valued node can be the input of any node with a date port. Colours: green = date lanes, amber = int field lanes, blue = a stored int column, magenta = an int32 column the evaluator derives per batch from a string column (a leaf), grey = a literal slot, violet = a condition (mask pair). Branch varka-task-61, 5 Sep 2026.</font>>];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [arrowsize=0.6, penwidth=1.1];
  subgraph cluster_src { label="inputs of the kernel"; fontsize=10; color="#9aa3ad"; style="rounded";
    Hdatecol [shape=box, style="rounded,filled", fillcolor="#cfe8e3", color="#2f8f82", label="Arrow date column"];
    Hlittab [shape=box, style="rounded,filled", fillcolor="#e6e6e3", color="#7a8088", label="literal table (per kernel)"];
    Hintcolsrc [shape=box, style="rounded,filled", fillcolor="#dbe6f5", color="#3b6fb6", label="Arrow int column"];
    Hstr [shape=box, style="rounded,filled", fillcolor="#f3dcea", color="#b0448a", label="Arrow string column"];
  }
  subgraph cluster_leaves { label="leaves and leaf-derived values"; fontsize=10; color="#9aa3ad"; style="rounded";
    Hcol [shape=box, style="rounded,filled", fillcolor="#e6e6e3", color="#3b6fb6", label="ColumnRef (any input)"];
    Hdate [shape=box, style="rounded,filled", fillcolor="#cfe8e3", color="#2f8f82", label=<<b>date value</b><br/><font point-size="8">ColumnRef over a date column, a date LiteralSlot,<br/>or the output of a date-valued node</font>>];
    Hint [shape=box, style="rounded,filled", fillcolor="#f6e3b5", color="#c08a1e", label=<<b>int field value</b><br/><font point-size="8">the output of an int-valued node, or an int literal<br/>(a bare int column is not admitted here)</font>>];
    Hintcol [shape=box, style="rounded,filled", fillcolor="#dbe6f5", color="#3b6fb6", label=<<b>int column</b><br/><font point-size="8">ColumnRef over a stored int column:<br/>day offset (38), month count with a runtime guard (60)</font>>];
    Hderived [shape=box, style="rounded,filled", fillcolor="#f3dcea", color="#b0448a", label=<<b>derived int32 column</b><br/><font point-size="8">ColumnRef the evaluator fills per batch:<br/>WeekdayLeaf (59) - dayOfWeek-1; TruncLevelLeaf (61) - codes 6..9</font>>];
    Hlit [shape=box, style="rounded,filled", fillcolor="#e6e6e3", color="#7a8088", label=<<b>LiteralSlot</b><br/><font point-size="8">day offset, month count (bounded), weekday k, date, compare literal</font>>];
    Hmask [shape=box, style="rounded,filled", fillcolor="#dcd8f1", color="#6a5bc4", label=<<b>condition</b><br/><font point-size="8">the output of a Cond node</font>>];
  }
  Hdatecol -> Hdate [color="#2f8f82"]; Hdatecol -> Hcol [color="#3b6fb6"]; Hintcolsrc -> Hintcol [color="#3b6fb6"]; Hintcolsrc -> Hcol [color="#3b6fb6"];
  Hstr -> Hderived [color="#b0448a", label="leaf, per batch", fontsize=8, fontcolor="#b0448a"]; Hlittab -> Hlit [color="#7a8088"]; Hlittab -> Hdate [color="#2f8f82", style=dashed];
  subgraph "cluster_day arithmetic" { label="day arithmetic"; fontsize=10; color="#9aa3ad"; style="rounded";
    AddDays [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" port="out"><b>AddDays</b><br/><font point-size="8">VARKA-10, VARKA-38</font></td></tr><tr><td port="days" bgcolor="white"><font point-size="9">days</font></td><td port="offset" bgcolor="white"><font point-size="9">offset</font></td></tr></table>>, fillcolor="#cfe8e3", style="filled"];
    SubDays [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" port="out"><b>SubDays</b><br/><font point-size="8">VARKA-10, VARKA-38</font></td></tr><tr><td port="days" bgcolor="white"><font point-size="9">days</font></td><td port="offset" bgcolor="white"><font point-size="9">offset</font></td></tr></table>>, fillcolor="#cfe8e3", style="filled"];
    DateDiff [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" port="out"><b>DateDiff</b><br/><font point-size="8">VARKA-10</font></td></tr><tr><td port="end" bgcolor="white"><font point-size="9">end</font></td><td port="start" bgcolor="white"><font point-size="9">start</font></td></tr></table>>, fillcolor="#f6e3b5", style="filled"];
  }
  subgraph "cluster_mod-7 family" { label="mod-7 family"; fontsize=10; color="#9aa3ad"; style="rounded";
    DayOfWeek [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="1" port="out"><b>DayOfWeek</b><br/><font point-size="8">VARKA-11</font></td></tr><tr><td port="days" bgcolor="white"><font point-size="9">days</font></td></tr></table>>, fillcolor="#f6e3b5", style="filled"];
    WeekDay [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="1" port="out"><b>WeekDay</b><br/><font point-size="8">VARKA-11</font></td></tr><tr><td port="days" bgcolor="white"><font point-size="9">days</font></td></tr></table>>, fillcolor="#f6e3b5", style="filled"];
    NextDay [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" port="out"><b>NextDay</b><br/><font point-size="8">VARKA-33, VARKA-59</font></td></tr><tr><td port="days" bgcolor="white"><font point-size="9">days</font></td><td port="offset" bgcolor="white"><font point-size="9">offset</font></td></tr></table>>, fillcolor="#cfe8e3", style="filled"];
  }
  subgraph "cluster_calendar (Chrono) and month arithmetic" { label="calendar (Chrono) and month arithmetic"; fontsize=10; color="#9aa3ad"; style="rounded";
    Year [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="1" port="out"><b>Year</b><br/><font point-size="8">VARKA-26</font></td></tr><tr><td port="days" bgcolor="white"><font point-size="9">days</font></td></tr></table>>, fillcolor="#f6e3b5", style="filled"];
    Month [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="1" port="out"><b>Month</b><br/><font point-size="8">VARKA-26</font></td></tr><tr><td port="days" bgcolor="white"><font point-size="9">days</font></td></tr></table>>, fillcolor="#f6e3b5", style="filled"];
    DayOfMonth [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="1" port="out"><b>DayOfMonth</b><br/><font point-size="8">VARKA-26</font></td></tr><tr><td port="days" bgcolor="white"><font point-size="9">days</font></td></tr></table>>, fillcolor="#f6e3b5", style="filled"];
    Quarter [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="1" port="out"><b>Quarter</b><br/><font point-size="8">VARKA-26</font></td></tr><tr><td port="days" bgcolor="white"><font point-size="9">days</font></td></tr></table>>, fillcolor="#f6e3b5", style="filled"];
    DayOfYear [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="1" port="out"><b>DayOfYear</b><br/><font point-size="8">VARKA-34</font></td></tr><tr><td port="days" bgcolor="white"><font point-size="9">days</font></td></tr></table>>, fillcolor="#f6e3b5", style="filled"];
    LastDay [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="1" port="out"><b>LastDay</b><br/><font point-size="8">VARKA-36</font></td></tr><tr><td port="days" bgcolor="white"><font point-size="9">days</font></td></tr></table>>, fillcolor="#cfe8e3", style="filled"];
    TruncDate [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="1" port="out"><b>TruncDate</b><br/><font point-size="8">VARKA-35; level is an enum, not an input</font></td></tr><tr><td port="days" bgcolor="white"><font point-size="9">days</font></td></tr></table>>, fillcolor="#cfe8e3", style="filled"];
    TruncDateDynamic [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" port="out"><b>TruncDateDynamic</b><br/><font point-size="8">VARKA-61</font></td></tr><tr><td port="days" bgcolor="white"><font point-size="9">days</font></td><td port="level" bgcolor="white"><font point-size="9">level</font></td></tr></table>>, fillcolor="#cfe8e3", style="filled"];
    AddMonths [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" port="out"><b>AddMonths</b><br/><font point-size="8">VARKA-40, VARKA-60</font></td></tr><tr><td port="days" bgcolor="white"><font point-size="9">days</font></td><td port="months" bgcolor="white"><font point-size="9">months</font></td></tr></table>>, fillcolor="#cfe8e3", style="filled"];
  }
  subgraph "cluster_selection" { label="selection"; fontsize=10; color="#9aa3ad"; style="rounded";
    Greatest [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" port="out"><b>Greatest</b><br/><font point-size="8">VARKA-11; type of its operands</font></td></tr><tr><td port="left" bgcolor="white"><font point-size="9">left</font></td><td port="right" bgcolor="white"><font point-size="9">right</font></td></tr></table>>, fillcolor="#cfe8e3", style="filled"];
    Least [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" port="out"><b>Least</b><br/><font point-size="8">VARKA-11; type of its operands</font></td></tr><tr><td port="left" bgcolor="white"><font point-size="9">left</font></td><td port="right" bgcolor="white"><font point-size="9">right</font></td></tr></table>>, fillcolor="#cfe8e3", style="filled"];
    IfElse [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" port="out"><b>IfElse</b><br/><font point-size="8">VARKA-11; type of its branches</font></td></tr><tr><td port="cond" bgcolor="white"><font point-size="9">cond</font></td><td port="then" bgcolor="white"><font point-size="9">then</font></td><td port="else" bgcolor="white"><font point-size="9">else</font></td></tr></table>>, fillcolor="#cfe8e3", style="filled"];
  }
  subgraph "cluster_conditions (Cond)" { label="conditions (Cond)"; fontsize=10; color="#9aa3ad"; style="rounded";
    Compare [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" port="out"><b>Compare</b><br/><font point-size="8">VARKA-11; op is an enum</font></td></tr><tr><td port="left" bgcolor="white"><font point-size="9">left</font></td><td port="right" bgcolor="white"><font point-size="9">right</font></td></tr></table>>, fillcolor="#dcd8f1", style="filled"];
    And [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" port="out"><b>And</b><br/><font point-size="8">VARKA-11</font></td></tr><tr><td port="left" bgcolor="white"><font point-size="9">left</font></td><td port="right" bgcolor="white"><font point-size="9">right</font></td></tr></table>>, fillcolor="#dcd8f1", style="filled"];
    Or [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" port="out"><b>Or</b><br/><font point-size="8">VARKA-11</font></td></tr><tr><td port="left" bgcolor="white"><font point-size="9">left</font></td><td port="right" bgcolor="white"><font point-size="9">right</font></td></tr></table>>, fillcolor="#dcd8f1", style="filled"];
    Not [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="1" port="out"><b>Not</b><br/><font point-size="8">VARKA-11</font></td></tr><tr><td port="child" bgcolor="white"><font point-size="9">child</font></td></tr></table>>, fillcolor="#dcd8f1", style="filled"];
    IsNotNull [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="1" port="out"><b>IsNotNull</b><br/><font point-size="8">VARKA-20</font></td></tr><tr><td port="child" bgcolor="white"><font point-size="9">child</font></td></tr></table>>, fillcolor="#dcd8f1", style="filled"];
  }
  Hdate -> AddDays:days:w [color="#2f8f82"];
  Hdate -> SubDays:days:w [color="#2f8f82"];
  Hdate -> DateDiff:end:w [color="#2f8f82"];
  Hdate -> DateDiff:start:w [color="#2f8f82"];
  Hdate -> NextDay:days:w [color="#2f8f82"];
  Hdate -> AddMonths:days:w [color="#2f8f82"];
  Hdate -> DayOfWeek:days:w [color="#2f8f82"];
  Hdate -> WeekDay:days:w [color="#2f8f82"];
  Hdate -> Year:days:w [color="#2f8f82"];
  Hdate -> Month:days:w [color="#2f8f82"];
  Hdate -> DayOfMonth:days:w [color="#2f8f82"];
  Hdate -> Quarter:days:w [color="#2f8f82"];
  Hdate -> DayOfYear:days:w [color="#2f8f82"];
  Hdate -> LastDay:days:w [color="#2f8f82"];
  Hdate -> TruncDate:days:w [color="#2f8f82"];
  Hdate -> TruncDateDynamic:days:w [color="#2f8f82"];
  Hdate -> Greatest:left:w [color="#2f8f82"];
  Hdate -> Greatest:right:w [color="#2f8f82"];
  Hdate -> Least:left:w [color="#2f8f82"];
  Hdate -> Least:right:w [color="#2f8f82"];
  Hdate -> IfElse:then:w [color="#2f8f82"];
  Hdate -> IfElse:else:w [color="#2f8f82"];
  Hdate -> Compare:left:w [color="#2f8f82"];
  Hdate -> Compare:right:w [color="#2f8f82"];
  Hint -> Greatest:left:w [color="#c08a1e"];
  Hint -> Greatest:right:w [color="#c08a1e"];
  Hint -> Least:left:w [color="#c08a1e"];
  Hint -> Least:right:w [color="#c08a1e"];
  Hint -> IfElse:then:w [color="#c08a1e"];
  Hint -> IfElse:else:w [color="#c08a1e"];
  Hint -> Compare:left:w [color="#c08a1e"];
  Hint -> Compare:right:w [color="#c08a1e"];
  Hintcol -> AddDays:offset:w [color="#3b6fb6"];
  Hintcol -> SubDays:offset:w [color="#3b6fb6"];
  Hintcol -> AddMonths:months:w [color="#3b6fb6"];
  Hderived -> NextDay:offset:w [color="#b0448a"];
  Hderived -> TruncDateDynamic:level:w [color="#b0448a"];
  Hlit -> AddDays:offset:w [color="#7a8088"];
  Hlit -> SubDays:offset:w [color="#7a8088"];
  Hlit -> AddMonths:months:w [color="#7a8088"];
  Hlit -> NextDay:offset:w [color="#7a8088"];
  Hlit -> Compare:right:w [color="#7a8088"];
  Hmask -> And:left:w [color="#6a5bc4"];
  Hmask -> And:right:w [color="#6a5bc4"];
  Hmask -> Or:left:w [color="#6a5bc4"];
  Hmask -> Or:right:w [color="#6a5bc4"];
  Hmask -> Not:child:w [color="#6a5bc4"];
  Hmask -> IfElse:cond:w [color="#6a5bc4"];
  Hcol -> IsNotNull:child:w [color="#3b6fb6"];
  subgraph cluster_out { label="what a node produces"; fontsize=10; color="#9aa3ad"; style="rounded";
    Rdate [shape=box, style="rounded,filled", fillcolor="#cfe8e3", color="#2f8f82", label=<<b>date value</b>>];
    Rint [shape=box, style="rounded,filled", fillcolor="#f6e3b5", color="#c08a1e", label=<<b>int field value</b>>];
    Rmask [shape=box, style="rounded,filled", fillcolor="#dcd8f1", color="#6a5bc4", label=<<b>condition</b>>];
  }
  Sink1 [shape=box, style="rounded,filled", fillcolor="white", color="#1d2126", label=<<b>fused projection output</b><br/><font point-size="8">an int32 Arrow column (date or int) plus its validity</font>>];
  Sink2 [shape=box, style="rounded,filled", fillcolor="white", color="#1d2126", label=<<b>selection bitmap</b><br/><font point-size="8">a Cond as the root: the filter's rows (VARKA-21)</font>>];
  AddDays:out:e -> Rdate [color="#2f8f82"];
  SubDays:out:e -> Rdate [color="#2f8f82"];
  DateDiff:out:e -> Rint [color="#c08a1e"];
  NextDay:out:e -> Rdate [color="#2f8f82"];
  AddMonths:out:e -> Rdate [color="#2f8f82"];
  DayOfWeek:out:e -> Rint [color="#c08a1e"];
  WeekDay:out:e -> Rint [color="#c08a1e"];
  Year:out:e -> Rint [color="#c08a1e"];
  Month:out:e -> Rint [color="#c08a1e"];
  DayOfMonth:out:e -> Rint [color="#c08a1e"];
  Quarter:out:e -> Rint [color="#c08a1e"];
  DayOfYear:out:e -> Rint [color="#c08a1e"];
  LastDay:out:e -> Rdate [color="#2f8f82"];
  TruncDate:out:e -> Rdate [color="#2f8f82"];
  TruncDateDynamic:out:e -> Rdate [color="#2f8f82"];
  Greatest:out:e -> Rdate [color="#2f8f82"]; Greatest:out:e -> Rint [color="#c08a1e"];
  Least:out:e -> Rdate [color="#2f8f82"]; Least:out:e -> Rint [color="#c08a1e"];
  IfElse:out:e -> Rdate [color="#2f8f82"]; IfElse:out:e -> Rint [color="#c08a1e"];
  Compare:out:e -> Rmask [color="#6a5bc4"];
  And:out:e -> Rmask [color="#6a5bc4"];
  Or:out:e -> Rmask [color="#6a5bc4"];
  Not:out:e -> Rmask [color="#6a5bc4"];
  IsNotNull:out:e -> Rmask [color="#6a5bc4"];
  Rdate -> Sink1 [color="#2f8f82"]; Rint -> Sink1 [color="#c08a1e"]; Rmask -> Sink2 [color="#6a5bc4"];
  Rdate -> Hdate [style=dotted, color="#2f8f82", constraint=false, label="feeds", fontsize=8, fontcolor="#2f8f82"];
  Rint -> Hint [style=dotted, color="#c08a1e", constraint=false, label="feeds", fontsize=8, fontcolor="#c08a1e"];
  Rmask -> Hmask [style=dotted, color="#6a5bc4", constraint=false, label="feeds", fontsize=8, fontcolor="#6a5bc4"];
}