digraph VarkaIR {
  graph [rankdir=TB, fontname="Helvetica", fontsize=11, labelloc=t, label=<<b>Varka IR: the sealed node families of VarkaVectorIR</b><br/><font point-size="9">branch varka-task-32-b2, 7 Sep 2026. A weight is the civil-from-days prefix plus the node's own tail (task 32 B2); the prefix is paid once per loop method. Fill: green = date output, amber = int field, violet = condition mask, grey = leaf. Edge = implements. A component named without a type takes any value node; the restricted positions say so.</font>>, pad=0.4, nodesep=0.3, ranksep=0.45, bgcolor="white", newrank=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, penwidth=1.2, margin="0.12,0.05"];
  edge  [color="#555555", arrowsize=0.7, penwidth=1];

  Root   [label=<<b>VarkaVectorIR</b><br/><font point-size="8">sealed interface, 14 permits</font>>, shape=box, style="rounded,filled,dashed", fillcolor="white", color="#1d2126"];
  Chrono [label=<<b>Chrono</b><br/><font point-size="8">sealed: one civil-from-days prefix, one tail each</font>>, style="rounded,filled,dashed", fillcolor="white", color="#1d2126"];
  Cond   [label=<<b>Cond</b><br/><font point-size="8">sealed: known-true / known-false words per lane</font>>, style="rounded,filled,dashed", fillcolor="white", color="#1d2126"];

  subgraph cluster_leaves { label="leaves"; fontsize=10; color="#9aa3ad"; style="rounded"; 
    ColumnRef   [label=<<b>ColumnRef</b>(ordinal)<br/><font point-size="8">an input's lanes; may be a derived int32 column (task 59)</font>>, fillcolor="#e6e6e3", color="#7a8088"];
    LiteralSlot [label=<<b>LiteralSlot</b>(index)<br/><font point-size="8">a broadcast literal</font>>, fillcolor="#e6e6e3", color="#7a8088"];
  }
  subgraph cluster_arith { label="day arithmetic (tasks 10, 38)"; fontsize=10; color="#9aa3ad"; style="rounded";
    AddDays  [label=<<b>AddDays</b>(days, offset)<br/><font point-size="8">offset: literal or int column (38)</font>>, fillcolor="#cfe8e3", color="#2f8f82"];
    SubDays  [label=<<b>SubDays</b>(days, offset)<br/><font point-size="8">offset: literal or int column (38)</font>>, fillcolor="#cfe8e3", color="#2f8f82"];
    DateDiff [label=<<b>DateDiff</b>(end, start)>, fillcolor="#f6e3b5", color="#c08a1e"];
  }
  subgraph cluster_pick { label="selection (task 11)"; fontsize=10; color="#9aa3ad"; style="rounded";
    IfElse   [label=<<b>IfElse</b>(cond, then, else)<br/><font point-size="8">also coalesce and CASE WHEN</font>>, fillcolor="#cfe8e3", color="#2f8f82"];
    Greatest [label=<<b>Greatest</b>(left, right)<br/><font point-size="8">null-skipping</font>>, fillcolor="#cfe8e3", color="#2f8f82"];
    Least    [label=<<b>Least</b>(left, right)<br/><font point-size="8">null-skipping</font>>, fillcolor="#cfe8e3", color="#2f8f82"];
  }
  subgraph cluster_week { label="mod-7 family (tasks 11, 33, 59)"; fontsize=10; color="#9aa3ad"; style="rounded";
    DayOfWeek [label=<<b>DayOfWeek</b>(days)<br/><font point-size="8">1..7, Sunday = 1</font>>, fillcolor="#f6e3b5", color="#c08a1e"];
    WeekDay   [label=<<b>WeekDay</b>(days)<br/><font point-size="8">0..6, Monday = 0</font>>, fillcolor="#f6e3b5", color="#c08a1e"];
    NextDay   [label=<<b>NextDay</b>(days, offset)<br/><font point-size="8">offset: literal k or the weekday leaf's column (59); weight 15</font>>, fillcolor="#cfe8e3", color="#2f8f82"];
  }
  AddMonths [label=<<b>AddMonths</b>(days, months)<br/><font point-size="8">months: literal or guarded int column (60); decompose + recompose,<br/>outside Chrono by design; weight 31 + 81</font>>, fillcolor="#cfe8e3", color="#2f8f82"];
  subgraph cluster_chrono { label="calendar (tasks 26, 34, 35, 36, 61)"; fontsize=10; color="#9aa3ad"; style="rounded";
    Year       [label=<<b>Year</b>(days)<br/><font point-size="8">weight 31 + 7</font>>, fillcolor="#f6e3b5", color="#c08a1e"];
    Month      [label=<<b>Month</b>(days)<br/><font point-size="8">weight 31 + 7</font>>, fillcolor="#f6e3b5", color="#c08a1e"];
    DayOfMonth [label=<<b>DayOfMonth</b>(days)<br/><font point-size="8">weight 31 + 7</font>>, fillcolor="#f6e3b5", color="#c08a1e"];
    Quarter    [label=<<b>Quarter</b>(days)<br/><font point-size="8">weight 31 + 7</font>>, fillcolor="#f6e3b5", color="#c08a1e"];
    DayOfYear  [label=<<b>DayOfYear</b>(days)<br/><font point-size="8">weight 31 + 14</font>>, fillcolor="#f6e3b5", color="#c08a1e"];
    LastDay    [label=<<b>LastDay</b>(days)<br/><font point-size="8">weight 31 + 32</font>>, fillcolor="#cfe8e3", color="#2f8f82"];
    TruncDate  [label=<<b>TruncDate</b>(days, level: TruncLevel)<br/><font point-size="8">YEAR | MONTH | QUARTER in the shape; weight 31 + 16 / 5 / 31</font>>, fillcolor="#cfe8e3", color="#2f8f82"];
    TruncDateDynamic [label=<<b>TruncDateDynamic</b>(days, level)<br/><font point-size="8">level: the trunc-level leaf's column only; all four periods blended; weight 31 + 60 (task 61)</font>>, fillcolor="#cfe8e3", color="#2f8f82"];
  }
  subgraph cluster_cond { label="conditions (tasks 11, 20, 21)"; fontsize=10; color="#9aa3ad"; style="rounded";
    Compare   [label=<<b>Compare</b>(op: CompareOp, left, right)<br/><font point-size="8">LT LE GT GE EQ in the shape</font>>, fillcolor="#dcd8f1", color="#6a5bc4"];
    And       [label=<<b>And</b>(left: Cond, right: Cond)>, fillcolor="#dcd8f1", color="#6a5bc4"];
    Or        [label=<<b>Or</b>(left: Cond, right: Cond)>, fillcolor="#dcd8f1", color="#6a5bc4"];
    Not       [label=<<b>Not</b>(child: Cond)<br/><font point-size="8">swaps the two words, no code</font>>, fillcolor="#dcd8f1", color="#6a5bc4"];
    IsNotNull [label=<<b>IsNotNull</b>(child: ColumnRef)<br/><font point-size="8">reads the input's validity word</font>>, fillcolor="#dcd8f1", color="#6a5bc4"];
  }

  edge [style=invis];
  ColumnRef -> LiteralSlot;
  AddDays -> SubDays -> DateDiff;
  IfElse -> Greatest -> Least;
  DayOfWeek -> WeekDay -> NextDay;
  Year -> Month -> DayOfMonth -> Quarter -> DayOfYear -> LastDay -> TruncDate -> TruncDateDynamic;
  Compare -> And -> Or -> Not -> IsNotNull;
  edge [style=solid];

  // implements
  Root -> {ColumnRef LiteralSlot AddDays SubDays DateDiff IfElse Greatest Least DayOfWeek WeekDay NextDay AddMonths Chrono Cond};
  Chrono -> {Year Month DayOfMonth Quarter DayOfYear LastDay TruncDate TruncDateDynamic};
  Cond -> {Compare And Or Not IsNotNull};

}
