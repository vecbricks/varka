<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Standalone Java 25 engine for the Varka project. Built with the Maven wrapper via
    `./build/mvn -f sql/varka/engine/pom.xml`. The Spark reactor shares the Java 25 baseline
    (root pom java.version), but the engine stays a separate module by design; its tests need
    the native-access and incubator-vector flags, which are not part of the Spark build.
    See sql/varka/IMPLEMENTATION_PLAN.md.
  -->
  <groupId>org.apache.spark.varka</groupId>
  <artifactId>varka-engine</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Varka Engine</name>
  <description>
    Standalone SIMD engine for the Varka MVP: date arithmetic (DATE +/- INTEGER, DATEDIFF)
    over Arrow buffers via the JDK Vector API and Panama MemorySegment.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <!--
      Must match <arrow.version> in the root pom: the kernels write into Arrow buffers that
      Spark allocated, so a mismatch is not benign. There is no parent pom to inherit it from
      (see the note above), so dev/check_varka_arrow_version.py guards it instead, and CI runs
      that check before building the engine.
    -->
    <arrow.version>19.0.0</arrow.version>
    <junit.version>5.10.2</junit.version>
    <maven.surefire.version>3.2.5</maven.surefire.version>
    <jmh.version>1.37</jmh.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-vector</artifactId>
      <version>${arrow.version}</version>
    </dependency>
    <!-- Netty allocation manager for the Arrow RootAllocator used in tests. -->
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-netty</artifactId>
      <version>${arrow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- JMH kernel microbenchmarks (Task 7). maven-jmh-plugin is not resolvable on this
         environment's Maven mirror, so the benchmarks are registered as an extra test source
         dir (build-helper) and run programmatically via the JMH Runner (exec:java, see the
         DateVectorOpsJMHRunner). `mvn test` compiles them but surefire skips them (they do not
         match the *Test patterns), so it is unaffected. -->
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
      <version>${jmh.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-generator-annprocess</artifactId>
      <version>${jmh.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <arg>--add-modules</arg>
            <arg>jdk.incubator.vector</arg>
            <!-- JDK 23+ disables classpath annotation processing by default; -proc:full lets
                 jmh-generator-annprocess produce the DateVectorOpsBenchmark*_jmhType classes. -->
            <arg>-proc:full</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven.surefire.version}</version>
        <configuration>
          <argLine>--add-modules jdk.incubator.vector --enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow -Dio.netty.tryReflectionSetAccessible=true --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.invoke=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.net=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/sun.nio.ch=ALL-UNNAMED --add-opens=java.base/sun.nio.cs=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <!-- The JMH benchmark sources live under `src/jmh/java`, added as a test source dir so they
           compile (and jmh-generator-annprocess produces the `*_jmhType*` classes) without
           polluting the main jar. `mvn test` never benchmarks: DateVectorOpsBenchmarkTest is an
           instant no-op unless `-Dvarka.jmh=true`, and surefire skips the `*Benchmark` class.
           Run: `./build/mvn -f sql/varka/engine/pom.xml test -Dvarka.jmh=true`. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-jmh-test-source</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>src/jmh/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
