; Lemma: the magic form's OR is disjoint below 2^52, so the bits read back are 2^52 + a
; in 2^52's binade.

(echo "a | 0x4330000000000000L read as a double is 2^52 + a for 0 <= a < 2^52: expect unsat")
(push 1)
(declare-const a Int)
(assert (and (<= 0 a) (< a 4503599627370496)))
(define-fun xb () Int (jlong.or.disjoint a 4841369599423283200))
(assert (not (and (= (jdouble.fromBits.E xb) 0) (= (jdouble.fromBits.M xb) (+ 4503599627370496 a)))))
(check-sat)
(pop 1)

; d = 1000

(echo "d = 1000: the conversion form's quotients for 0 < v < 2^53 lie in binades 2^-9 to 2^-62: expect unsat")
(push 1)
(declare-const v Int)
(assert (and (<= 1 v) (< v 9007199254740992)))
(assert (not (and (>= (* v 4611686018427387904) 4503599627370496000) (not (>= (* v 512) 9007199254740992000)))))
(check-sat)
(pop 1)

(echo "d = 1000: the conversion form is v / d for 0 < |v| < 2^53, quotient in binade 2^-8: expect unsat")
(push 1)
(declare-const v Int)
(declare-const M Int)
(declare-const r Int)
(assert (and (< 0 (abs v)) (< (abs v) 9007199254740992)))
; L2D leaves v as it is (the lemma); |v| / |d| rounds to M * 2^-8; D2L truncates it
(assert (jdouble.rne (abs v) 1000 M 1 256))
(assert (jdouble.d2l.mag r M 1 256))
(assert (not (= (ite (= (< v 0) false) r (- r)) (jlong.div v 1000))))
(check-sat)
(pop 1)

