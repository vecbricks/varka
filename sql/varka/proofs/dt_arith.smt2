(define-fun dt.rF () Int (jlong.sub y (jlong.mul dt.qF 86400000000)))
(define-fun dt.y () Int (jlong.add dt.rF (jlong.add (jlong.shr y 63) 1)))
(define-fun dt.h () Int (jlong.add (jlong.mul dt.qF 43200000000) (jlong.shr dt.y 1)))
