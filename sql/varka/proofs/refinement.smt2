(echo "lemma 1a, the era's tail over its quotients: the century of the scaled day of era is 0 to 3: expect unsat")
(push 1)
(declare-const e Int)
(assert (and (<= 0 e) (< e 146097)))
(declare-const c Int) (declare-const yoe Int) (declare-const doy Int)
(declare-const mi3 Int) (declare-const d0 Int)
(define-fun quad () Int (+ (* 4 e) 3))
(assert (and (<= 0 (- quad (* 146097 c))) (< (- quad (* 146097 c)) 146097)))
(define-fun jul () Int (+ quad (* 4 c)))
(assert (and (<= 0 (- jul (* 1461 yoe))) (< (- jul (* 1461 yoe)) 1461)))
(define-fun rm () Int (- jul (* 1461 yoe)))
(assert (and (<= 0 (- rm (* 4 doy))) (< (- rm (* 4 doy)) 4)))
(define-fun mn () Int (+ (* 2141 doy) 197913))
(assert (and (<= 0 (- mn (* 65536 mi3))) (< (- mn (* 65536 mi3)) 65536)))
(define-fun lo () Int (- mn (* 65536 mi3)))
(assert (and (<= 0 (- lo (* 2141 d0))) (< (- lo (* 2141 d0)) 2141)))
(define-fun ty () Int (+ yoe (ite (>= doy 306) 1 0)))
(define-fun tm () Int (ite (< mi3 13) mi3 (- mi3 12)))
(define-fun td () Int (+ d0 1))
(assert (not (and (<= 0 c) (<= c 3))))
(check-sat)
(pop 1)

(echo "lemma 1a, and in century 0 every day of era gives a valid date whose count from 0000-03-01 is the day of era: expect unsat")
