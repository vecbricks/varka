(declare-const k Int)
(assert (not (and (= (spec.days (+ y (* 400 k)) m d) (+ (spec.days y m d) (* 146097 k))) (= (spec.mlen (+ y (* 400 k)) m) (spec.mlen y m)))))
(check-sat)
(pop 1)

(echo "lemma 3, the composition: over the era step's range every day decomposes into a valid date whose count is the day: expect unsat")
(push 1)
(declare-const n Int)
(assert (and (<= (- 5394572) n) (<= n 14766813)))
(define-fun e () Int (k.doe n))
(assert (and (spec.date (t.year e) (t.month e) (t.dom e)) (= (spec.days (t.year e) (t.month e) (t.dom e)) (- e 719468))))
(define-fun kk () Int (- (k.era n) 32))
(assert (and (= (spec.days (+ (t.year e) (* 400 kk)) (t.month e) (t.dom e)) (+ (spec.days (t.year e) (t.month e) (t.dom e)) (* 146097 kk))) (= (spec.mlen (+ (t.year e) (* 400 kk)) (t.month e)) (spec.mlen (t.year e) (t.month e)))))
(assert (not (and (spec.date (k.year n) (k.month n) (k.dom n)) (= (spec.days (k.year n) (k.month n) (k.dom n)) n))))
(check-sat)
(pop 1)

