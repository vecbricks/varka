; The long lane's constant division (VarkaVectorIR.ConstDivide) by the divisors of the
; 64-bit decimal casts (VarkaDecimalCastCompiler, VARKA-350) that long_divide.smt2 does
; not state: 10^k for k from 10 to 15, below 2^52 where a value of up to 15 digits is
; divided whole, and 5^k for k from 1 to 18 but 2, 7 and 9, the magnitude form's divisor
; after its shift by k. Both forms VarkaDivisionLowering.emitConstDivide takes at the long
; lane are Java's v / d for every dividend below ConstDivide.EXACT_DIVIDEND_BOUND = 2^52,
; stated as long_divide.smt2 states them, whose header describes the forms; the lemmas
; they rest on are its own: an integer below 2^53 rounds to itself, and the magic form's
; OR is disjoint below 2^52. decimal_casts.smt2 proves each division's dividend under that
; bound.
;
; Rendered by VarkaProofFiles. VarkaProofFilesSuite fails when this file differs from its
; rendering, and VARKA_PROOFS_REGEN=true build/sbt 'catalyst/testOnly *VarkaProofFilesSuite'
; rewrites it. Run by dev/varka_prove.sh, which inserts java.smt2 after the set-logic line.

(set-logic QF_NIA)

; d = 5

(echo "d = 5: the conversion form's quotients for 0 < v < 2^53 lie in binades 2^-2 to 2^-55: expect unsat")
(push 1)
(declare-const v Int)
(assert (and (<= 1 v) (< v 9007199254740992)))
(assert (not (and (>= (* v 36028797018963968) 22517998136852480) (not (>= (* v 4) 45035996273704960)))))
(check-sat)
(pop 1)

(echo "d = 5: the conversion form is v / d for 0 < |v| < 2^53, quotient in binade 2^-1: expect unsat")
(push 1)
(declare-const v Int)
(declare-const M Int)
(declare-const r Int)
(assert (and (< 0 (abs v)) (< (abs v) 9007199254740992)))
; L2D leaves v as it is (the lemma); |v| / |d| rounds to M * 2^-1; D2L truncates it
(assert (jdouble.rne (abs v) 5 M 1 2))
(assert (jdouble.d2l.mag r M 1 2))
(assert (not (= (ite (= (< v 0) false) r (- r)) (jlong.div v 5))))
(check-sat)
(pop 1)

