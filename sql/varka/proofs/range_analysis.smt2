(echo "NextDay: the lane's d + 1 + floorMod(k - d, 7) is congruent to m + 1 + r in [lo + 1, hi + 7], whatever the child's wrap: expect unsat")
(push 1)
(declare-const lo Int) (declare-const hi Int) (declare-const m Int)
(assert (and (<= lo m) (<= m hi)))
(define-fun jc () Int (jint.wrap m))
(declare-const k Int)
(assert (and (<= (- 1) k) (<= k 5)))
(define-fun r () Int (jint.floorMod (jint.sub k jc) 7))
(define-fun jn () Int (jint.add (jint.add jc 1) r))
(assert (not (and (<= (ra.nextday.lo lo hi) (+ m 1 r)) (<= (+ m 1 r) (ra.nextday.hi lo hi)) (= (jint.wrap (+ m 1 r)) jn))))
(check-sat)
(pop 1)

