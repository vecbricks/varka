; The long lane (VARKA-104): with every child's interval and the node's own
; within the long, the lane value is the exact value, in the interval. A literal is
; its point, and an int widened to the long lane is in the int range.

(echo "Long IntArith ADD: within the long, the lane's x + y is the exact sum, in [a + c, b + d]: expect unsat")
(push 1)
(declare-const a Int) (declare-const b Int) (declare-const x Int)
(declare-const c Int) (declare-const d Int) (declare-const y Int)
(assert (and (<= a x) (<= x b) (<= c y) (<= y d)))
(assert (and (jlong.in a) (jlong.in b) (jlong.in c) (jlong.in d)))
(assert (and (jlong.in (ra.add.lo a b c d)) (jlong.in (ra.add.hi a b c d))))
(assert (not (and (<= (ra.add.lo a b c d) (jlong.add x y)) (<= (jlong.add x y) (ra.add.hi a b c d)) (= (jlong.add x y) (+ x y)))))
(check-sat)
(pop 1)

