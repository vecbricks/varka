(echo "D = 40: the first 39 digits are cut, e is not the cut: expect sat")
(push 1)
(declare-const e Int) (declare-const f Int)
(assert (and (<= 1000000000000000000000000000000000000000 e) (< e 10000000000000000000000000000000000000000) (<= (* 10 f) e) (< e (* 10 (+ f 1)))))
(assert (not (= e (* 10 f))))
(check-sat)
