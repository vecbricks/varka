(declare-const xh Int)
(declare-const xl Int)
(declare-const yh Int)
(declare-const yl Int)
(assert (and (w.hi xh) (w.lo xl) (w.hi yh) (w.lo yl)))
(declare-const va Bool)
(declare-const vb Bool)
(assert (not (= (and (or (and (= xh yh) va vb) (and (not va) (not vb))) (or (and (= xl yl) va vb) (and (not va) (not vb)))) (or (and va vb (= (w.val xh xl) (w.val yh yl))) (and (not va) (not vb))))))
(check-sat)
(pop 1)

