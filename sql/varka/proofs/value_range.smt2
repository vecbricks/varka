(assert (and (<= a x) (<= x b)))
(declare-const s1 Int) (declare-const s2 Int) (declare-const s Int)
(assert (and (<= s1 s) (<= s s2)))
(assert (not (and (<= (vr.shift.lo a b s1 s2) (+ x s)) (<= (+ x s) (- (vr.shift.hi a b s1 s2) 1)))))
(check-sat)
(pop 1)

